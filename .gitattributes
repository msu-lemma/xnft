# GitLab syntax highlighting & preventing 3-way merges
pixi.lock merge=binary gitlab-language=yaml gitlab-generated=true
*.csv filter=lfs diff=lfs merge=lfs -text
*.ffd filter=lfs diff=lfs merge=lfs -text
*.nfd filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.af filter=lfs diff=lfs merge=lfs -text
